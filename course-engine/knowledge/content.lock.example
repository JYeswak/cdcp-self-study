# Example content.lock schema (L7-S9 / OQ-03)
# Real lock lives at course-engine/content.lock (generated, not hand-edited).
#
# Generate:  cdcp content-lock
# Verify:    cdcp_gate verify-content-lock
# Regen:     cdcp content-lock

schema_version = 1
canonical = "cdcp-bank-v1"
hash_alg = "sha256"
# bank_hash = "<hex from: cdcp bank-hash>"

# [knowledge]
# "knowledge/exam_form.toml" = "<sha256>"
# …

# [modules]
# "web/content/modules/01-mission-critical.md" = "<sha256>"
# "modules/01-mission-critical.md" = "<sha256>"
# …
