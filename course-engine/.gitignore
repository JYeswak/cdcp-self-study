# bv (beads viewer) local config and caches
.bv/

# beads compliance audit (own .git; never pollute product history)
beads_compliance_audit/

# Local-first attempt store (opt-in; never a product artifact)
/var/

# Build / tooling
/target/
**/*.rs.bk
.DS_Store

# Loop watchdog runtime state (bd-engine-not-gate-ar39.15 wiring, 2026-08-19).
# These are produced by .flywheel/watchdog-escalate.sh on every cron tick. They
# are OBSERVATIONS, not source: committing them makes every watchdog run a diff.
# ALERT itself stays tracked — it is the durable stall record.
.flywheel/.stall-streak
.flywheel/watchdog.cron.log
.flywheel/URGENT_JOSH.md
.flywheel/URGENT_JOSH.resolved-*
.flywheel/.crontab.backup-*

# beads local history rotation. `br` writes timestamped snapshots here on every
# operation and prunes old ones, so tracking it made 133 git entries of pure
# churn per session. The canonical, git-tracked record is .beads/issues.jsonl.
.beads/.br_history/
